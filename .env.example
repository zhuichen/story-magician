# ========== 大模型（方舟 Responses API） ==========
ARK_API_KEY=your_ark_api_key_here
ARK_MODEL=doubao-seed-2-0-lite-260215

# ========== 火山引擎（文生图 + 文生视频） ==========
# 在「火山引擎控制台 → 访问控制 → 访问密钥」中获取
VOLC_ACCESS_KEY_ID=your_volc_access_key_id_here
VOLC_SECRET_ACCESS_KEY=your_volc_secret_access_key_here

# ========== 语音合成（儿童友好声音） ==========
# 在「火山引擎控制台 → 豆包语音 → 应用管理」中创建应用获取
VOLC_TTS_APPID=your_tts_appid_here
VOLC_TTS_TOKEN=your_tts_token_here
VOLC_TTS_CLUSTER=volcano_tts

# ========== 服务端口 ==========
PORT=3200

# ========== 视频生成（默认关闭，模型较慢） ==========
# 设为 true 开启文生视频功能
ENABLE_VIDEO=false
