{
  "name": "story-magician",
  "version": "1.0.0",
  "description": "故事魔法师 - 面向3-6岁幼儿的绘本创编伙伴智能体",
  "main": "app.js",
  "scripts": {
    "build": "echo 'Build skipped for Node.js app'",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "docker:build": "docker build -t story-magician .",
    "docker:run": "docker run -p 3200:3200 --env-file .env story-magician",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:build": "docker-compose build",
    "deploy": "npm run docker:compose:build && npm run docker:compose:up"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "docx": "^9.6.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
