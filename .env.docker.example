# Docker 部署环境变量示例
# 复制此文件为 .env 并填入实际值

# ===================
# 必填配置
# ===================

# 字节跳动 Ark 大模型 API Key
# 获取地址: https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here

# 火山引擎 Access Key ID
# 获取地址: https://console.volcengine.com/iam
VOLC_ACCESS_KEY_ID=your_volc_access_key_id_here

# 火山引擎 Secret Access Key
VOLC_SECRET_ACCESS_KEY=your_volc_secret_access_key_here

# ===================
# 可选配置
# ===================

# 大模型 ID（使用豆包模型）
ARK_MODEL=doubao-seed-2-0-lite-260215

# 服务端口（默认 3200）
PORT=3200

# 是否开启文生视频功能（默认 false）
ENABLE_VIDEO=false

# 允许的 CORS 源（用逗号分隔，留空则允许所有）
ALLOWED_ORIGINS=
